{
  "name": "wyn",
  "displayName": "Wyn — The Wyn Programming Language",
  "description": "Syntax highlighting and LSP support for the Wyn programming language",
  "version": "1.16.1",
  "publisher": "wynlang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:wyn"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "wyn",
        "aliases": [
          "Wyn",
          "wyn"
        ],
        "extensions": [
          ".wyn",
          ".🐉"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wyn",
        "scopeName": "source.wyn",
        "path": "./syntaxes/wyn.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Wyn",
      "properties": {
        "wyn.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Wyn Language Server"
        },
        "wyn.lsp.path": {
          "type": "string",
          "default": "wyn",
          "description": "Path to wyn executable"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wynlang/vscode-wyn"
  },
  "homepage": "https://wynlang.com"
}
